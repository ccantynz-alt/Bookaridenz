# ============================================================
# BookARide V2 Frontend — Environment Variables
# Copy to .env.local for local dev, or set in Vercel dashboard.
# ============================================================

# Backend API URL
# Production: leave unset — vercel.json proxies /api/* to the live
# bookaride.co.nz API so all bookings land in the shared database.
# Local dev: point directly at the live API.
VITE_API_URL=https://www.bookaride.co.nz/api

# Google Maps API Key (same key as backend, or a browser-restricted one)
VITE_GOOGLE_MAPS_API_KEY=AIza...
